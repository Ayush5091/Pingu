# The Vercel CLI uploads everything not listed here (it does not read .gitignore).
# Secrets come from the project's Vercel environment variables, never from files.
.env
.env.*
*.env
*.pem
*.key

# Not part of the web app. Leading "/" anchors to the project root:
# a bare "rag/" would also drop src/app/api/rag and src/lib/rag.
/spark_flutter/
/rag/
/SPARK.png

# Local build output and tooling
/.next/
/node_modules/
*.tsbuildinfo
*.log
